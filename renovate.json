{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Presets from https://github.com/bcgov/renovate-config",
  "extends": [
    "github>bcgov/renovate-config#2026.10.29"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Keep alembic/3.14 on Python 3.14; do not bump across minor versions",
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "alembic/3.14/**"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
